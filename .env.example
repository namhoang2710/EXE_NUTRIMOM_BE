# Database PostgreSQL (Supabase / Local / Neon / Docker)
# Vi du voi Supabase (Connection string port 5432):
# NUTRIMOM_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# NUTRIMOM_DB_USER=postgres
# NUTRIMOM_DB_PASSWORD=your-supabase-db-password

NUTRIMOM_DB_URL=jdbc:postgresql://localhost:5432/NutriMomDB?currentSchema=app
NUTRIMOM_DB_USER=postgres
NUTRIMOM_DB_PASSWORD=change-me
NUTRIMOM_FLYWAY_USER=postgres
NUTRIMOM_FLYWAY_PASSWORD=change-me
NUTRIMOM_REDIS_HEALTH_ENABLED=false
NUTRIMOM_JWT_SECRET=replace-with-at-least-32-random-characters
NUTRIMOM_OTP_HMAC_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
NUTRIMOM_OTP_EXPOSE_DEBUG_CODE=false
NUTRIMOM_DEMO_USER_ENABLED=true
NUTRIMOM_ADMIN_USER_ENABLED=false
NUTRIMOM_ADMIN_PHONE=
NUTRIMOM_ADMIN_PASSWORD=
NUTRIMOM_ADMIN_DISPLAY_NAME=NutriMom Admin
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# PayOS Payment Gateway (https://payos.vn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# NutriMom Assistant: key only belongs on the backend.
# Enable Zero Data Retention in Groq Console > Data Controls before confirming.
GROQ_API_KEY=
GROQ_ZDR_CONFIRMED=false
NUTRIMOM_ASSISTANT_ENABLED=true
NUTRIMOM_ASSISTANT_MODEL=openai/gpt-oss-20b
NUTRIMOM_ASSISTANT_DAILY_USER_LIMIT=20
NUTRIMOM_ASSISTANT_DAILY_GLOBAL_LIMIT=100
NUTRIMOM_ASSISTANT_DAILY_TOKEN_BUDGET=150000
NUTRIMOM_ASSISTANT_RETENTION_DAYS=30
