# Database PostgreSQL (Supabase / Local / Neon / Docker)
# Vi du voi Supabase (Connection string port 5432):
# NUTRIMOM_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# NUTRIMOM_DB_USER=postgres
# NUTRIMOM_DB_PASSWORD=your-supabase-db-password

NUTRIMOM_DB_URL=jdbc:postgresql://localhost:5432/NutriMomDB?currentSchema=app
NUTRIMOM_DB_USER=postgres
NUTRIMOM_DB_PASSWORD=change-me
NUTRIMOM_FLYWAY_USER=postgres
NUTRIMOM_FLYWAY_PASSWORD=change-me
NUTRIMOM_REDIS_HEALTH_ENABLED=false
NUTRIMOM_JWT_SECRET=replace-with-at-least-32-random-characters
NUTRIMOM_OTP_HMAC_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
NUTRIMOM_OTP_EXPOSE_DEBUG_CODE=false
NUTRIMOM_DEMO_USER_ENABLED=true
NUTRIMOM_ADMIN_USER_ENABLED=false
NUTRIMOM_ADMIN_PHONE=
NUTRIMOM_ADMIN_PASSWORD=
NUTRIMOM_ADMIN_DISPLAY_NAME=NutriMom Admin
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
NUTRIMOM_PUSH_TOKEN_KEY=replace-with-output-of-openssl-rand-base64-32
NUTRIMOM_PUSH_ENABLED=true

# PayOS Payment Gateway (https://payos.vn)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/payment/success
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# NutriMom Assistant: key only belongs on the backend.
# Enable Zero Data Retention in Groq Console > Data Controls before confirming.
GROQ_API_KEY=
GROQ_ZDR_CONFIRMED=false
NUTRIMOM_ASSISTANT_ENABLED=true
NUTRIMOM_ASSISTANT_MODEL=openai/gpt-oss-20b
NUTRIMOM_ASSISTANT_DAILY_USER_LIMIT=20
NUTRIMOM_ASSISTANT_DAILY_GLOBAL_LIMIT=100
NUTRIMOM_ASSISTANT_DAILY_TOKEN_BUDGET=150000
NUTRIMOM_ASSISTANT_RETENTION_DAYS=30

# Email SMTP (Gmail / Resend / SendGrid)
# De trong SPRING_MAIL_HOST de chay che do Mock khi test local: khong gui gi, chi log dia chi
# nguoi nhan da che, delivery_status=FAILED voi error=NOT_CONFIGURED.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Host duoc tin cert. Doi khi dung provider khac gmail.
SPRING_MAIL_SSL_TRUST=smtp.gmail.com
# Timeout (ms). Khong co thi SMTP treo se treo luon request va giu connection DB.
SPRING_MAIL_CONNECT_TIMEOUT=5000
SPRING_MAIL_READ_TIMEOUT=10000
SPRING_MAIL_WRITE_TIMEOUT=10000
MAGIC_LINK_BASE_URL=http://localhost:5173/auth/verify

# Origin cua frontend, dung de dung link trong email moi thanh vien gia dinh.
# Luon la http(s) thuong; app mobile sau nay se tu mo bang Universal Links / App Links.
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_FRONTEND_INVITE_PATH=/family/invite
# Tat de backend khong gui email moi, chi tra invite_url cho chu nhom tu gui.
# Chi gate kenh email; thong bao in-app van duoc tao binh thuong.
NUTRIMOM_FAMILY_INVITE_EMAIL_ENABLED=true
# Dia chi gui. DE TRONG thi roi ve SPRING_MAIL_USERNAME — dung cho Gmail, vi provider chi cho gui
# tu chinh tai khoan da dang nhap. Dat mot dia chi khac ma provider khong cho phep thi thu bi tu
# choi hoac viet lai, tuc la khong toi noi trong khi phia minh trong nhu da gui xong.
# Thieu ca hai thi backend khong thu gui, tra FAILED voi error=NO_SENDER.
APP_MAIL_FROM=

# Video consultations — backend only. See docs/consultation-video.md.
NUTRIMOM_VIDEO_ENABLED=true
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
